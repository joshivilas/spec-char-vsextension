{
  "name": "special-characters-viewer",
  "displayName": "Special Characters Viewer",
  "description": "Toggle visibility of special characters like newlines, tabs, and other invisible characters",
  "version": "0.0.1",
  "publisher": "joshivilas",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshivilas/special-characters-viewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "specialChars.toggle",
        "title": "Toggle Special Characters"
      }
    ],
    "keybindings": [
      {
        "command": "specialChars.toggle",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
